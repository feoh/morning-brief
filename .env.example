# Required for `morning-brief run`.
# Create a Discord bot token in the Discord developer portal and invite it to the server.
DISCORD_BOT_TOKEN=replace_me

# Optional. Defaults to #morning-brief: 1510832637407662142
DISCORD_CHANNEL_ID=1510832637407662142

# Daily Firehose RSS article integration.
# The API URL is local on the daily-firehose VM; the public URL is used for clickable Discord links.
DAILY_FIREHOSE_API_URL=http://127.0.0.1:8000
DAILY_FIREHOSE_PUBLIC_URL=https://daily-firehose.reedfish-regulus.ts.net
DAILY_FIREHOSE_API_TOKEN=replace_me
AGENT_LINK_SECRET=replace_me
MORNING_BRIEF_RSS_ARTICLE_LIMIT=20

# Optional top-news headline count. Defaults to 5.
MORNING_BRIEF_NEWS_HEADLINE_LIMIT=5

# Optional scheduling defaults used by install-schedule examples/config.
MORNING_BRIEF_TIME=06:00
MORNING_BRIEF_TIMEZONE=America/New_York
